{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/browser/**",
    "src/devtools/**",
    "src/issue-thread/**",
    "src/react/**",
    "src/scenarios/**",
    "src/standalone/**"
  ]
}
