# Git hooks must keep LF line endings on Windows checkouts. A CRLF shebang
# line (`#!/usr/bin/env bash\r`) is parsed by the kernel as the literal
# program name `bash\r`, which doesn't exist — and the hook silently fails.
.githooks/** text eol=lf
scripts/**/*.sh text eol=lf
scripts/**/*.command text eol=lf
# Runner generators compare their output byte-for-byte on every build.
packages/paperclip-runner/** text=auto eol=lf
packages/paperclip-eval-kernel/** text=auto eol=lf
